    {
      "parameters": {
        "jsCode": "const counters = {};\n\nreturn $input.all().map(item => {\n  const { value, type } = item.json;\n\n  counters[type] = (counters[type] || 0) + 1;\n\n  const number = String(counters[type]).padStart(3, '0');\n\n  return {\n    json: {\n      value,\n      type,\n      placeholder: `[${type}_${number}]`\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
