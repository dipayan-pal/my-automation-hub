      "position": [
        1632,
        -96
      ],
      "id": "e562d1bd-90ef-4734-97fc-66b038b7811a",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "jsCode": "\nconst originalText = $('Extract from File').first().json.data;\n\n// Get plaintext mappings from Generate Placeholders\nconst mappings = $('Generate Placeholders').all();\n\n// Keep only valid mappings\nconst validMappings = mappings.filter(item =>\n  typeof item.json.value === 'string' &&\n  item.json.value.length > 0 &&\n  typeof item.json.placeholder === 'string'\n);\n\n// Work on a copy of the original text\nlet redactedText = originalText;\n\n// Sort by original value length (longest first)\nconst sortedMappings = [...validMappings].sort((a, b) =>\n  b.json.value.length - a.json.value.length\n);\n\n// Replace original PII with placeholders\nfor (const item of sortedMappings) {\n  const { value, placeholder } = item.json;\n\n  redactedText = redactedText.split(value).join(placeholder);\n}\n\nreturn [\n  {\n    json: {\n      session_id: validMappings[0]?.json.session_id ?? null,\n      original_text: originalText,\n      redacted_text: redactedText\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        -16
      ],
      "id": "ec2f640e-1edc-47cb-adee-8069c482a7d7",
      "name": "replace original text with redacted values"
    },
    {
      "parameters": {
        "jsCode": "\n// Get decrypted mappings from the Crypto Decrypt node\nconst mappings = $input.all();\n\n// Get the cloud LLM response\nconst llmResponse = $('Cloud LLM').first().json.text;\n\n// Sort mappings by placeholder length (longest first)\nconst sortedMappings = [...mappings].sort((a, b) =>\n  b.json.placeholder.length - a.json.placeholder.length\n);\n\n// Start with the cloud LLM response\nlet reconstructedText = llmResponse;\n\n// Replace placeholders with their decrypted original values\nfor (const item of sortedMappings) {\n  const { placeholder, original_value } = item.json;\n\n  if (\n    typeof placeholder !== 'string' ||\n    typeof original_value !== 'string'\n  ) {\n    continue;\n  }\n\n  reconstructedText = reconstructedText\n    .split(placeholder)\n    .join(original_value);\n}\n\n// Return reconstructed response\nreturn [\n  {\n    json: {\n      session_id: mappings[0]?.json.session_id ?? null,\n      reconstructed_text: reconstructedText\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        -16
