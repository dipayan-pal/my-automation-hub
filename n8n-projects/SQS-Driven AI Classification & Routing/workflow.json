    {
      "parameters": {
        "jsCode": "// SQS JSON-protocol responses arrive as a string under `data`\nconst first = $input.first().json;\nconst raw = first.data;\nconst parsed = (typeof raw === 'string' && raw.length)\n  ? JSON.parse(raw)\n  : (raw && typeof raw === 'object' ? raw : first);\n\nconst messages = parsed.Messages || [];\n\n// Empty array = queue is empty, this branch simply ends\nreturn messages.map(m => {\n  let body = m.Body;\n  try { body = JSON.parse(m.Body); } catch (e) {}\n  return {\n    json: {\n      messageId: m.MessageId,\n      receiptHandle: m.ReceiptHandle,\n      body\n    }\n  };\n});"
      },
